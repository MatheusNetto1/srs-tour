# Variáveis lidas pelo Docker Compose (compose.yml). Copie para `.env` na raiz
# só se precisar mudar algo; os valores abaixo já são os padrões.
#
# Para rodar dois clones ao mesmo tempo, mude também COMPOSE_PROJECT_NAME e as
# portas em um deles.
# COMPOSE_PROJECT_NAME=srs-tour

POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
