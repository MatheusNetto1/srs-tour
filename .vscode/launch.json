{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Backend: uvicorn",
			"type": "debugpy",
			"request": "launch",
			"module": "uvicorn",
			"args": ["app.main:app", "--port", "8000"],
			"cwd": "${workspaceFolder}/backend",
			"envFile": "${workspaceFolder}/backend/.env"
		},
		{
			"name": "Backend: pytest (arquivo atual)",
			"type": "debugpy",
			"request": "launch",
			"module": "pytest",
			"args": ["${file}"],
			"cwd": "${workspaceFolder}/backend",
			"envFile": "${workspaceFolder}/backend/.env"
		}
	]
}
