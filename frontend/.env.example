# Copie para `frontend/.env` só se precisar mudar algo; os valores abaixo já são
# os padrões.

# Base da API usada pelo cliente HTTP (mesma origem, via proxy do Vite).
VITE_API_BASE_URL=/api/v1

# Destino do proxy `/api` do Vite e origem do `/openapi.json` (make front-api-types).
API_PROXY_TARGET=http://localhost:8000
